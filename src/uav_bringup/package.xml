<?xml version="1.0"?>
<package format="3">
  <name>uav_bringup</name>
  <version>0.1.0</version>
  <description>Project-owned bringup for the offline planning pipeline.</description>
  <maintainer email="maintainer@example.com">UAV Workspace Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ego_planner</exec_depend>
